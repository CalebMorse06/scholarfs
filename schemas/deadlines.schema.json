{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarfs:schema:deadlines:1",
  "title": "ScholarFS deadlines",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deadlines"],
  "properties": {
    "schema_version": { "const": 1 },
    "deadlines": {
      "type": "array",
      "items": { "$ref": "#/$defs/deadline" }
    }
  },
  "$defs": {
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at"],
          "properties": { "at": { "type": "string", "format": "date-time" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["on"],
          "properties": { "on": { "type": "string", "format": "date" } }
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "manual" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "connector", "connector_version", "external_id", "observed_at"],
          "properties": {
            "type": { "const": "connector" },
            "connector": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "connector_version": { "type": "string", "minLength": 1 },
            "external_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "course", "title", "kind", "due", "status", "priority",
        "weight_percent", "estimated_minutes", "source", "url",
        "reminders_minutes", "tags", "notes", "created_at", "updated_at", "completed_at"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "course": { "type": ["string", "null"], "pattern": "^[A-Z0-9](?:[A-Z0-9._-]{0,30}[A-Z0-9_-])?$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["assignment", "exam", "quiz", "lab", "project", "reading", "presentation", "event", "other"] },
        "due": { "$ref": "#/$defs/due" },
        "status": { "enum": ["pending", "completed", "cancelled"] },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "weight_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "estimated_minutes": { "type": ["integer", "null"], "minimum": 1 },
        "source": { "$ref": "#/$defs/source" },
        "url": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "uri", "pattern": "^https?://" }
          ]
        },
        "reminders_minutes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "notes": { "type": "string", "maxLength": 10000 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "properties": { "completed_at": { "type": "string", "format": "date-time" } } },
          "else": { "properties": { "completed_at": { "type": "null" } } }
        }
      ]
    }
  }
}
